# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRIAL_DAYS=14

# Public legal pages. Use the registered legal name and an address/phone that
# can actually receive inquiries. If omitted, the pages show disclosure-on-request.
# Defaults follow https://tokyo307inc.com/ and may be overridden here.
LEGAL_PROVIDER_NAME=トーキョーサンマルナナ株式会社
LEGAL_PROVIDER_ADDRESS=〒105-0013 東京都港区浜松町2-2-15 2F
LEGAL_PROVIDER_PHONE=
LEGAL_REPRESENTATIVE_NAME=八坂 太洋
LEGAL_RESPONSIBLE_PERSON=安藤 達也
LEGAL_CONTACT_EMAIL=info@tokyo307inc.com
# LEGAL_EFFECTIVE_DATE は全ページ共通の「制定・施行日」のみ。「最終改定日」は
# lib/legal-revisions.ts でページごとに管理する（本文を変えたページだけ更新）。
LEGAL_EFFECTIVE_DATE=2026年8月26日

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me_anon
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role

# Platform operator access (server-only; never prefix with NEXT_PUBLIC_).
# Prefer immutable Supabase Auth user UUIDs. Comma-separated; empty = nobody.
SUPER_ADMIN_USER_IDS=
# Optional bootstrap/fallback allowlist. Comma-separated and case-insensitive.
SUPER_ADMIN_EMAILS=
# Optional pin for Admin MCP platform tools (orgs.create / orgs.status).
# When set, gb_adm_ must belong to this org UUID in addition to owner allowlist match.
PLATFORM_OPS_ORG_ID=

# Stripe
STRIPE_SECRET_KEY=replace_me_stripe_secret
STRIPE_WEBHOOK_SECRET=replace_me_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_me_publishable
# Recurring (JPY / month, 税込表示額) — create in Stripe Dashboard, then paste Price IDs.
# Do NOT invent fake price_… ids. See docs/stripe-billing-notes.md checklist.
STRIPE_PRICE_ID_STARTER=replace_me_price_starter
STRIPE_PRICE_ID_BUSINESS=replace_me_price_business
STRIPE_PRICE_ID_MANAGED=replace_me_price_managed
# One-time business onboarding (¥150,000 税込・仮決め). Optional; Checkout adds
# as an extra line item only when this is set (not replace_me_*).
STRIPE_PRICE_ID_BUSINESS_ONBOARDING=replace_me_price_business_onboarding
# One-time optional kickoff pack (¥398,000 税込・仮決め). Transparent 3 lines
# in docs/pricing-sku-catalog.md. Does NOT include Business first month.
# Checkout wiring only after a real Dashboard Price ID is pasted.
STRIPE_PRICE_ID_KICKOFF_PACK=replace_me_price_kickoff_pack
# Subsidy-related placeholders (catalog only — NO approval/payout guarantee).
# Create Prices in Dashboard after business amounts are finalized.
STRIPE_PRICE_ID_SUBSIDY_2Y_BUSINESS=replace_me_price_subsidy_2y_business
STRIPE_PRICE_ID_SUBSIDY_2Y_MANAGED=replace_me_price_subsidy_2y_managed
STRIPE_PRICE_ID_YEAR3_EXTENSION=replace_me_price_year3_extension
# Overage metered Price (P0.5 stub — not wired yet):
# STRIPE_PRICE_ID_OVERAGE_STARTER / _BUSINESS / _MANAGED — create later in Dashboard
# Set to 1 after enabling bank transfer / customer_balance in Stripe Dashboard
STRIPE_ENABLE_CUSTOMER_BALANCE=0
BILLING_NOTIFY_EMAIL=owner@example.com

# Resend (transactional email)
RESEND_API_KEY=replace_me_resend
EMAIL_FROM=Staffpass（AIエージェントの社員証） <noreply@your-verified-domain.com>

# Tenant notification credential encryption (required in production, 32+ chars).
# Generate once, keep stable, and never expose it with NEXT_PUBLIC_*.
NOTIFICATION_CONFIG_ENCRYPTION_KEY=

# Pilot-only global Telegram fallback.
# Production code permits these values ONLY for the org containing the active
# member info@tokyo307inc.com. Every other tenant uses /app/settings DB config.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs. Empty = everyone in the chat.
TELEGRAM_ALLOWED_USER_IDS=
# Vercel Cron bearer secret for /api/cron/telegram-digest
CRON_SECRET=

# Demo / local
# When keys are replace_me_* the app runs in demo mode (in-memory + stub email/stripe).

# Dual mode (lib/mode.ts isDemoMode)
# Missing / replace_me_* Supabase keys → DEMO in-memory store.
# Paste real Supabase URL + anon + service_role LAST. See docs/production-cutover.md


# DEMO durable approvals (Vercel multi-isolate)
# Without one of these, Gateway-created tickets stay process-local and may not
# appear in Approvals UI / Bot poll across serverless instances.

# Optional Sealith commerce audit correlation. Both products remain standalone
# when these flags are false. Start with staging and external_reference only.
STAFFPASS_SEALITH_EVENTS_ENABLED=false
STAFFPASS_SEALITH_PROJECTIONS_ENABLED=false
CROSS_PRODUCT_EVENT_ENVIRONMENT=staging
SEALITH_AUTHORITY_EVENTS_URL=https://www.sealith.com/api/integrations/external-authority/events
STAFFPASS_SEALITH_EVENT_SECRET=
SEALITH_STAFFPASS_EVENT_SECRET=
# JSON object: {"<staffpassOrgId>":"<sealithOrgId>"}
STAFFPASS_SEALITH_TENANT_MAP={}
# Prefer Upstash Redis (or Vercel KV marketplace — same KV_REST_API_* vars):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or GitHub Contents on branch `demo-store` (file approvals.json):
# DEMO_APPROVALS_GITHUB_TOKEN=
# DEMO_APPROVALS_GITHUB_REPO=pacifico-1106/grokbot-control-plane
# Or generic HTTP JSON GET/PUT store:
# APPROVAL_DEMO_STORE_URL=
# APPROVAL_DEMO_STORE_TOKEN=

# Staffpass Slack app (user-token OAuth for postingAs=user). NOT Cursor Slack OAuth.
# Redirect: https://staffpass.sealith.com/api/slack/oauth/callback (and localhost).
# User scopes: chat:write, users:read, channels:read, groups:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional. Default: NEXT_PUBLIC_APP_URL + /api/slack/oauth/callback
SLACK_OAUTH_REDIRECT_URL=
# SLACK_BOT_TOKEN / SLACK_CONVERSATION_BOT_TOKEN are NOT used for conversation posts
# (removed 2026-10-04: in multi-tenant production the env bot belongs to one workspace).
# Each org registers its own xoxb on the conversation adapter (dashboard
# 「チャンネルに書き込む」 or setup.slackAdapter.setBotToken). With no org token,
# production posts fail with slack_token_missing (demo mode keeps the stub).

# G4 Slack DM reply inline (default OFF). When ON (=true), comm.reply / slack.post
# into a Slack DM (D… or channel_type im) posts to the DM's main flow even under
# reply_policy prefer_thread; a message already inside a thread (thread_ts ≠ ts)
# is answered in that thread. Channels unchanged. See docs/reply-policy.md.
# SLACK_DM_REPLY_INLINE_ENABLED=true

# Duplicate-reply prevention for conversation tools (default OFF). Requires
# migration 20261004700000 FIRST. When ON (=true): the same / a re-written body
# to the same conversation within the window is not sent (duplicate_reply_suppressed);
# a newer reply or approval request with the same / a similar body supersedes
# older pending conversation approvals (another matter stays pending); approvals
# are re-checked at fulfill (same criterion) and expire. Hash-only ledger.
# Fails closed (nothing sent) without a key. See docs/comm-reply-dedup.md.
# COMM_REPLY_DEDUP_ENABLED=true
# COMM_REPLY_DEDUP_WINDOW_MINUTES=30      # 1–1440
# COMM_REPLY_DEDUP_MODE=similar           # exact | similar
# COMM_REPLY_DEDUP_SIMILARITY=0.6         # 0.5–1 (similar mode)
# COMM_REPLY_APPROVAL_TTL_MINUTES=1440    # 5–10080; pending conversation approvals expire
# COMM_REPLY_DEDUP_HMAC_KEY=              # optional, ≥ 32 chars; else derived from NOTIFICATION_CONFIG_ENCRYPTION_KEY

# Channel classification proposals (default OFF). Requires migration
# 20261005200000 FIRST. When ON: a Slack / LINE / Telegram channel the org
# joins (or a post denied in an unregistered channel) opens a channels.classify
# ticket (+ parties.upsert for mixed Slack channels) in the approval channel.
# Always human-approved, never applied automatically; one open ticket per
# channel. See docs/channel-classify-proposals.md.
# CHANNEL_CLASSIFY_PROPOSALS_ENABLED=true
# Stuck notices (default OFF): unregistered-channel deny, ledger / backfill
# failures, unset notifyMouth → approver → default approval channel → ops
# (PLATFORM_OPS_ORG_ID audit mirror + APPROVAL_ALERT_OPS_EMAILS). Rate-limited.
# CHANNEL_STUCK_NOTIFY_ENABLED=true
# Per-org hourly caps (requires migration 20261005400000). Over the cap → one
# summary notice per hour, nothing more. Bounded 1–200.
# CHANNEL_CLASSIFY_MAX_PROPOSALS_PER_HOUR=20
# CHANNEL_STUCK_MAX_NOTICES_PER_HOUR=30

# comm.delete (default OFF). When ON (=true), an AI employee may delete its OWN
# posts that Staffpass recorded (same org, same employee), e.g. a duplicate send.
# Slack only (chat.delete with the token that made the post; chat:write covers
# it, no new scope). LINE / Telegram return not_supported. See docs/comm-delete.md.
# COMM_DELETE_ENABLED=true
# Only posts recorded within this many hours can be deleted (default 72, 1..720).
# An own post that is older answers too_old (others' posts always get the same 404).
# COMM_DELETE_MAX_AGE_HOURS=72

# sns.publish — official APIs after Staffpass approval. Do NOT invent live tokens.
# Do NOT use Cursor X MCP tweet.write. Missing credentials → Japanese
# fulfillment.error; the approval ticket stays approved.
# Org table: org_sns_adapters / org_sns_adapter_secrets (SQL comment).
# Next step for X: X Developer Portal OAuth 2.0 user token with tweet.write,
# then paste as X_USER_ACCESS_TOKEN (POST https://api.x.com/2/tweets).
# X_USER_ACCESS_TOKEN=
# X_BEARER_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
# NOTE_API_TOKEN=
# YOUTUBE_ACCESS_TOKEN=
# SNS_PUBLISH_STUB=1

# G7 Cross-team wake routing — Option A: cross_team_wake_bindings (default OFF).
# When ON (=1), after team-scoped identity lookup fails to match a mentioned user,
# the wake path checks explicit cross-team wake bindings (cross_team_wake_bindings table).
# Fail-closed: missing/ambiguous bindings do NOT wake; never guesses cross-org by name.
# Production enable requires separate GO after design lock + admin MCP tooling.
# G7_CONNECT_WAKE_ROUTING=1

